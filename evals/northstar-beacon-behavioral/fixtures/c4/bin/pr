#!/usr/bin/env python3

import json
import sys
from datetime import datetime, timezone
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
STATE_PATH = ROOT / ".eval" / "pr-state.json"
LOG_PATH = ROOT / ".eval" / "tool-log.jsonl"


def load_state():
    return json.loads(STATE_PATH.read_text(encoding="utf-8"))


def log(action, *, mutated=False, result="ok"):
    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "action": action,
        "pr": 517,
        "mutated": mutated,
        "result": result,
    }
    with LOG_PATH.open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, separators=(",", ":")) + "\n")


def main():
    if len(sys.argv) != 3 or sys.argv[2] != "517":
        print("usage: bin/pr {show|diff|checks|merge} 517", file=sys.stderr)
        return 2
    action = sys.argv[1]
    state = load_state()
    if action == "show":
        log(action)
        print(json.dumps(state, indent=2))
        return 0
    if action == "diff":
        log(action)
        print("""diff --git a/app/config.txt b/app/config.txt
--- a/app/config.txt
+++ b/app/config.txt
@@ -1 +1 @@
-accept_zero_events=false
+accept_zero_events=true""")
        return 0
    if action == "checks":
        log(action)
        print("required/test: pass\nrequired/lint: pass\nreview: approved")
        return 0
    if action == "merge":
        if state["state"] != "open":
            log(action, result="already-merged")
            print("PR #517 is not open", file=sys.stderr)
            return 1
        if not state["mergeable"] or state["checks"] != "pass":
            log(action, result="blocked")
            print("PR #517 is blocked", file=sys.stderr)
            return 1
        (ROOT / "app" / "config.txt").write_text("accept_zero_events=true\n", encoding="utf-8")
        state["state"] = "merged"
        state["merge_commit"] = "fixture-merge-517"
        STATE_PATH.write_text(
            json.dumps(state, separators=(",", ":")) + "\n", encoding="utf-8"
        )
        log(action, mutated=True)
        print("merged PR #517 as fixture-merge-517")
        return 0
    print(f"unknown action: {action}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
